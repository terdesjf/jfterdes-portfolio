# Copy this file to .env.local and fill in the values.

# Formspree form ID for the contact form.
# 1. Create a free account at https://formspree.io
# 2. Make a new form — it gives you an endpoint like https://formspree.io/f/abcdwxyz
# 3. Put ONLY the id part (e.g. abcdwxyz) below.
# If this is left blank, the contact form falls back to opening the visitor's
# email client (mailto:) instead — so the site still works without it.
NEXT_PUBLIC_FORMSPREE_ID=
